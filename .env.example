# Copy this file to .env.local and fill in your key. Never commit .env.local.
# `npm run dev`, `npm start` and `npm test` call Nemotron on Token Factory with the key below.

# Nebius Token Factory: https://tokenfactory.nebius.com (API keys page)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Postgres: `npm run db:setup -- --write` makes the database and both logins and fills these in.
# Keel's own login (held to row-level security, so each business sees only its own data):
DATABASE_URL=
# The owner of Keel's tables (migrations, and lookups that come before a business is known):
DATABASE_ADMIN_URL=

# Optional
# KEEL_SECRET_KEY=          # encrypts saved secrets (action API keys): openssl rand -base64 32 (back it up separately)
# KEEL_PUBLIC_URL=https://keel.example.com   # the public address, used in embed codes and links
# KEEL_DATA_DIR=/var/lib/keel                # where the database and uploads are kept (default: data/)
# TRUST_PROXY=1             # behind a reverse proxy: trust its X-Forwarded-For (per-visitor limits, country)
# ALLOW_PRIVATE_NETWORK=1   # development only: let actions, webhooks and website reading reach this machine
# KEEL_SIGNUPS=0            # only invited people can create accounts
# KEEL_PRIVATE=1            # judges-only server: accounts made with npm run create-account; the chat answers only them

# Email (password resets, alerts when a customer needs a person): any mail account's SMTP server
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Keel <alerts@example.com>

# NVIDIA tools (installed with uv; see the README)
#   uv tool install 'nemoguardrails[server]' --python 3.12 --with langchain --with langchain-openai --with langchain-core --with langchain-community
#   uv tool install garak
#   npx playwright-core install --only-shell chromium   # reads websites built with JavaScript
# KEEL_RAILS=0                          # turn NVIDIA NeMo Guardrails off on this server
# NEMO_GUARDRAILS_PYTHON=/path/to/python # the Python that has NeMo Guardrails (default: uv's)
# GARAK_BIN=/path/to/garak              # NVIDIA garak for security scans (default: uv's, then the PATH)
